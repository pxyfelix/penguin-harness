{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clinical curated memory pack",
  "type": "object",
  "required": ["version", "approvedBy", "approvedAt", "entries", "contentHash"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "scope", "file"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "scope": { "enum": ["company", "capability"] },
          "capability": { "type": "string" },
          "file": { "type": "string" },
          "source_report_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
