{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clinical feedback conflict group",
  "type": "object",
  "required": ["id", "title", "claims", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^CF-[A-Za-z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "report_ids"],
        "properties": {
          "claim": { "type": "string" },
          "report_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "status": { "enum": ["pending", "decided", "deferred"] },
    "decision": { "type": ["string", "null"] },
    "decided_by": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
